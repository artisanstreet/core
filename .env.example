# Copy to .env for local dev. Never commit real secrets.
CORE_ENV=dev
DATABASE_URL=postgres://core:core@127.0.0.1:55432/core
CORE_PUBLIC_BASE_URL=http://127.0.0.1:8787
CORE_JWT_ISSUER=http://127.0.0.1:8787
# Browser origins for exact credentialed CORS (auth + dashboard).
# Local dev may leave unset (same-origin only); browser flows set explicit
# http loopback origins. Production uses https://auth.artisan.st and
# https://dashboard.artisan.st via Wrangler vars.
# AUTH_PUBLIC_BASE_URL=http://127.0.0.1:5201
# DASHBOARD_PUBLIC_BASE_URL=http://127.0.0.1:5101
# Dev-only master key (32 random bytes, base64url). Production MUST set a real
# secret via Wrangler/Hyperdrive secrets; boot refuses dev keys in production.
CORE_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
MAIL_PROVIDER=log
MAIL_FROM=Ast <noreply@example.invalid>
