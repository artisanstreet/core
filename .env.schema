# @defaultRequired=false
# @defaultSensitive=false
# ---

# Local Postgres for Reylo/migrations/dev. May carry prod creds via override: sensitive.
# @required
# @sensitive
# @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=postgres://core:core@127.0.0.1:55432/core

# @required
# @type=enum(dev, test, production)
CORE_ENV=dev

# @optional
# @type=url
CORE_PUBLIC_BASE_URL=http://127.0.0.1:8787

# @optional
# @type=url
CORE_JWT_ISSUER=

# 32B base64url, no padding. Production refuses the dev default.
# @required
# @sensitive
CORE_MASTER_KEY=

# @optional
# @type=enum(log, resend, cloudflare)
MAIL_PROVIDER=log

# @optional
MAIL_FROM=

# @optional
MAIL_FROM_NAME=

# @sensitive
# @required=eq($MAIL_PROVIDER, resend)
RESEND_API_KEY=

# @optional
# @sensitive
CORE_ADMIN_TOKEN=

# @optional
CORE_SPA_APPROVE_PATH=

# @optional
# @type=url
CORE_RELAY_ORIGIN=
