{
  "$schema": "https://developers.cloudflare.com/schemas/config/wrangler.jsonc",
  "name": "ast-core",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CORE_ENV": "production",
    "CORE_PUBLIC_BASE_URL": "https://api.artisan.st",
    "CORE_JWT_ISSUER": "https://api.artisan.st",
    "MAIL_PROVIDER": "resend"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Server-side caching MUST be disabled on this Hyperdrive config
      // (wrangler hyperdrive create/update ... --caching-disabled; verify
      // with `wrangler hyperdrive get <id>`). There is no caching flag in
      // this file — it lives on the Hyperdrive config itself. See
      // docs/deployment.md "One-time provisioning". Local dev ignores this
      // binding and uses localConnectionString instead (no cache there).
      "id": "replace-with-hyperdrive-id",
      "localConnectionString": "postgres://core:core@127.0.0.1:55432/core"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONFIG_BUCKET",
      "bucket_name": "ast-core-config"
    }
  ]
}
