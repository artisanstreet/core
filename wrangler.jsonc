{
  "$schema": "https://developers.cloudflare.com/schemas/config/wrangler.jsonc",
  "name": "ast-core",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CORE_ENV": "production",
    "CORE_PUBLIC_BASE_URL": "https://core.artisanstreet.dev",
    "CORE_JWT_ISSUER": "https://core.artisanstreet.dev",
    "MAIL_PROVIDER": "resend"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "replace-with-hyperdrive-id",
      "localConnectionString": "postgres://core:core@127.0.0.1:55432/core"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONFIG_BUCKET",
      "bucket_name": "ast-core-config"
    }
  ],
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "none"
  }
}
