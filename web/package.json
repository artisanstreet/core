{
  "name": "ast-core-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AST account browser UI: sign-in, machines, sessions, vault, config, and remote-Forge threads over the Relay Noise channel.",
  "scripts": {
