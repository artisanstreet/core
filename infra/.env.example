# ast-core infra deploy inputs. Copy to stage-specific files (NEVER commit real
# secrets; only this .example is committed). Stage files are gitignored:
#   infra/.env.prod, infra/.env.pr-42, ...
# Load via shell env or --env-file; stage itself comes from the CLI
# (--stage / ALCHEMY_STAGE), not from these files.
#
# IMPORTANT: use distinct origins per stage. Never reuse prod domains for
# preview/dev stages — the second custom-domain attach would move ownership
# (separate Workers cannot share one custom-domain hostname).

# --- Public origins (shared names; exact https bare origins, no path) ---
# Prod example:
AST_CORE_ORIGIN=https://api.artisan.st
AST_RELAY_ORIGIN=https://relay.editor.artisan.st
AST_AUTH_ORIGIN=https://auth.artisan.st
AST_DASHBOARD_ORIGIN=https://dashboard.artisan.st
# Preview example (use instead of the above for preview stages):
# AST_CORE_ORIGIN=https://core-pr-42.example.dev
# AST_RELAY_ORIGIN=https://relay-pr-42.example.dev
# AST_AUTH_ORIGIN=https://auth-pr-42.example.dev
# AST_DASHBOARD_ORIGIN=https://dashboard-pr-42.example.dev

# --- External Postgres origin (secret; direct URL, no pooled URL) ---
AST_CORE_DATABASE_URL=postgres://app:CHANGE-ME@db.example.com:5432/app

# --- Secrets (all required for deploy; never logged, never in outputs) ---
# 32 random bytes, base64url, no padding:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CORE_MASTER_KEY=CHANGE-ME
CORE_ADMIN_TOKEN=CHANGE-ME
# RESEND_API_KEY is only for the legacy resend mailer (dev compat).
# The production cloudflare mailer needs no Resend secret.
# RESEND_API_KEY=CHANGE-ME

# --- Mail sender (REQUIRED bare verified Cloudflare sender on mail.artisan.st) ---
MAIL_FROM=auth@mail.artisan.st
# Optional display name (defaults to Artisan Street):
# MAIL_FROM_NAME=Artisan Street
