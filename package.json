{
  "name": "ast-core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AST account authority: identity, sessions, machine enrollment, grants, vault, config.",
  "scripts": {
    "db:setup": "node scripts/db-migrate.ts",
    "typecheck": "tsrs --noEmit --runExternalCode",
    "test": "vp test",
    "dev": "vp dev . --port 8787",
    "build": "vp build .",
    "build:web": "pnpm --dir web run build --",
    "contracts:emit": "EMIT_CONTRACTS=1 vp test run tests/contracts/emit.test.ts",
    "contracts:check": "vp test run tests/contracts/emit.test.ts",
    "preview": "vp preview . --port 8787",
    "infra:build": "pnpm --dir infra run build --",
    "infra:check": "pnpm --dir infra run check --",
    "infra:plan": "pnpm --dir infra run plan --",
    "infra:deploy": "pnpm --dir infra run deploy --",
    "infra:verify": "pnpm --dir infra run verify:bundle --"
  },
  "dependencies": {
    "@effect/platform": "0.97.2",
    "@oslojs/otp": "1.1.0",
    "@reylosql/postgres": "0.5.0",
    "effect": "3.22.4",
    "jose": "6.2.13",
    "postgres": "3.4.9",
    "reylo": "0.5.0",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@electric-sql/pglite": "0.5.12",
    "@oslojs/encoding": "^1.1.0",
    "@types/node": "^24.0.0",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "typescript": "7.1.0-beta",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  },
  "engines": {
    "node": "^24.11.0"
  }
}
